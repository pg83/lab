{% set metrics = [
  {
    'title': 'cell write latency p50 (receive to reply, fsync included)',
    'host_expr': 'histogram_quantile(0.5, sum by (job, le) (rate(s3_cell_write_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.5, sum by (le) (rate(s3_cell_write_seconds_bucket{job=~"s3_cell_.*"}[1m])))',
    'unit': 's',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell write latency p99 (receive to reply, fsync included)',
    'host_expr': 'histogram_quantile(0.99, sum by (job, le) (rate(s3_cell_write_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_cell_write_seconds_bucket{job=~"s3_cell_.*"}[1m])))',
    'unit': 's',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell read latency p50',
    'host_expr': 'histogram_quantile(0.5, sum by (job, le) (rate(s3_cell_read_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.5, sum by (le) (rate(s3_cell_read_seconds_bucket{job=~"s3_cell_.*"}[1m])))',
    'unit': 's',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell read latency p99',
    'host_expr': 'histogram_quantile(0.99, sum by (job, le) (rate(s3_cell_read_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_cell_read_seconds_bucket{job=~"s3_cell_.*"}[1m])))',
    'unit': 's',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell appends/s by result',
    'host_expr': 'sum by (job, result) (rate(s3_cell_writes_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (result) (rate(s3_cell_writes_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{job}} {{result}}',
    'cluster_legend': '{{result}}',
  },
  {
    'title': 'cell appended bytes/s',
    'host_expr': 'sum by (job) (rate(s3_cell_write_bytes_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum(rate(s3_cell_write_bytes_total[1m]))',
    'unit': 'Bps',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell reads/s by result',
    'host_expr': 'sum by (job, result) (rate(s3_cell_reads_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (result) (rate(s3_cell_reads_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{job}} {{result}}',
    'cluster_legend': '{{result}}',
  },
  {
    'title': 'cell read bytes/s',
    'host_expr': 'sum by (job) (rate(s3_cell_read_bytes_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum(rate(s3_cell_read_bytes_total[1m]))',
    'unit': 'Bps',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell tick p99 by phase (write to SSD, fsync)',
    'host_expr': 'histogram_quantile(0.99, sum by (job, phase, le) (rate(s3_cell_tick_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (phase, le) (rate(s3_cell_tick_seconds_bucket{job=~"s3_cell_.*"}[1m])))',
    'unit': 's',
    'host_legend': '{{job}} {{phase}}',
    'cluster_legend': '{{phase}}',
  },
  {
    'title': 'cell flush to HDD p99 by phase',
    'host_expr': 'histogram_quantile(0.99, sum by (job, phase, le) (rate(s3_cell_flush_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (phase, le) (rate(s3_cell_flush_seconds_bucket{job=~"s3_cell_.*"}[1m])))',
    'unit': 's',
    'host_legend': '{{job}} {{phase}}',
    'cluster_legend': '{{phase}}',
  },
  {
    'title': 'cell block load from HDD p99',
    'host_expr': 'histogram_quantile(0.99, sum by (job, le) (rate(s3_cell_hdd_read_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_cell_hdd_read_seconds_bucket{job=~"s3_cell_.*"}[1m])))',
    'unit': 's',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell blocks served/s by source (lru, store, hdd)',
    'host_expr': 'sum by (job, source) (rate(s3_cell_blocks_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (source) (rate(s3_cell_blocks_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{job}} {{source}}',
    'cluster_legend': '{{source}}',
  },
  {
    'title': 'cell errors/s by op',
    'host_expr': 'sum by (job, op) (rate(s3_cell_errors_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (op) (rate(s3_cell_errors_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{job}} {{op}}',
    'cluster_legend': '{{op}}',
  },
  {
    'title': 'cell write queue (requests waiting for a tick)',
    'host_expr': 's3_cell_write_queue_requests{host="HOST"}',
    'cluster_expr': 'sum(s3_cell_write_queue_requests)',
    'unit': 'short',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell flush queue (full blocks waiting for the HDD)',
    'host_expr': 's3_cell_flush_queue_blocks{host="HOST"}',
    'cluster_expr': 'sum(s3_cell_flush_queue_blocks)',
    'unit': 'short',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell read queue (block requests waiting for the loader)',
    'host_expr': 's3_cell_read_queue_requests{host="HOST"}',
    'cluster_expr': 'sum(s3_cell_read_queue_requests)',
    'unit': 'short',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell LRU on the load SSD',
    'host_expr': 's3_cell_lru_bytes{host="HOST"}',
    'cluster_expr': 'sum(s3_cell_lru_bytes)',
    'unit': 'bytes',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell LRU evictions/s',
    'host_expr': 'sum by (job) (rate(s3_cell_lru_evictions_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum(rate(s3_cell_lru_evictions_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell head growth (acked appends)',
    'host_expr': 'deriv(s3_cell_head_bytes{host="HOST"}[5m])',
    'cluster_expr': 'sum(deriv(s3_cell_head_bytes[5m]))',
    'unit': 'Bps',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell HDD pointer growth (flushed)',
    'host_expr': 'deriv(s3_cell_hdd_pointer_bytes{host="HOST"}[5m])',
    'cluster_expr': 'sum(deriv(s3_cell_hdd_pointer_bytes[5m]))',
    'unit': 'Bps',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'cell disk used',
    'host_expr': 's3_cell_head_bytes{host="HOST"} / s3_cell_capacity_bytes{host="HOST"}',
    'cluster_expr': 'sum(s3_cell_head_bytes) / sum(s3_cell_capacity_bytes)',
    'unit': 'percentunit',
    'host_legend': '{{job}}',
    'cluster_legend': 'sum',
  },
  {
    'title': 'front requests/s by method and code',
    'host_expr': 'sum by (method, target, code) (rate(s3_front_requests_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (method, target, code) (rate(s3_front_requests_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{method}} {{target}} {{code}}',
    'cluster_legend': '{{method}} {{target}} {{code}}',
  },
  {
    'title': 'front GET object latency p50',
    'host_expr': 'histogram_quantile(0.5, sum by (le) (rate(s3_front_request_seconds_bucket{host="HOST",method="GET",target="object"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.5, sum by (le) (rate(s3_front_request_seconds_bucket{method="GET",target="object"}[1m])))',
    'unit': 's',
    'host_legend': 'HOST',
    'cluster_legend': 'p50',
  },
  {
    'title': 'front GET object latency p99',
    'host_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_front_request_seconds_bucket{host="HOST",method="GET",target="object"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_front_request_seconds_bucket{method="GET",target="object"}[1m])))',
    'unit': 's',
    'host_legend': 'HOST',
    'cluster_legend': 'p99',
  },
  {
    'title': 'front PUT object latency p50',
    'host_expr': 'histogram_quantile(0.5, sum by (le) (rate(s3_front_request_seconds_bucket{host="HOST",method="PUT",target="object"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.5, sum by (le) (rate(s3_front_request_seconds_bucket{method="PUT",target="object"}[1m])))',
    'unit': 's',
    'host_legend': 'HOST',
    'cluster_legend': 'p50',
  },
  {
    'title': 'front PUT object latency p99',
    'host_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_front_request_seconds_bucket{host="HOST",method="PUT",target="object"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_front_request_seconds_bucket{method="PUT",target="object"}[1m])))',
    'unit': 's',
    'host_legend': 'HOST',
    'cluster_legend': 'p99',
  },
  {
    'title': 'front errors/s (5xx and gone clients)',
    'host_expr': 'sum by (code) (rate(s3_front_requests_total{host="HOST",code=~"5..|499"}[1m]))',
    'cluster_expr': 'sum by (code) (rate(s3_front_requests_total{code=~"5..|499"}[1m]))',
    'unit': 'ops',
    'host_legend': '{{code}}',
    'cluster_legend': '{{code}}',
  },
  {
    'title': 'front received bytes/s (put bodies)',
    'host_expr': 'rate(s3_front_received_bytes_total{host="HOST"}[1m])',
    'cluster_expr': 'sum(rate(s3_front_received_bytes_total[1m]))',
    'unit': 'Bps',
    'host_legend': 'HOST',
    'cluster_legend': 'sum',
  },
  {
    'title': 'front sent bytes/s',
    'host_expr': 'rate(s3_front_sent_bytes_total{host="HOST"}[1m])',
    'cluster_expr': 'sum(rate(s3_front_sent_bytes_total[1m]))',
    'unit': 'Bps',
    'host_legend': 'HOST',
    'cluster_legend': 'sum',
  },
  {
    'title': 'front bodies in flight',
    'host_expr': 's3_front_bodies_in_flight{host="HOST"}',
    'cluster_expr': 'sum(s3_front_bodies_in_flight)',
    'unit': 'short',
    'host_legend': 'HOST',
    'cluster_legend': 'sum',
  },
  {
    'title': 'front to cell append p99 by cell',
    'host_expr': 'histogram_quantile(0.99, sum by (cell, le) (rate(s3_link_seconds_bucket{job="s3_front",host="HOST",op="append"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (cell, le) (rate(s3_link_seconds_bucket{job="s3_front",op="append"}[1m])))',
    'unit': 's',
    'host_legend': 'cell {{cell}}',
    'cluster_legend': 'cell {{cell}}',
  },
  {
    'title': 'front to cell read p99 by cell',
    'host_expr': 'histogram_quantile(0.99, sum by (cell, le) (rate(s3_link_seconds_bucket{job="s3_front",host="HOST",op="read"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (cell, le) (rate(s3_link_seconds_bucket{job="s3_front",op="read"}[1m])))',
    'unit': 's',
    'host_legend': 'cell {{cell}}',
    'cluster_legend': 'cell {{cell}}',
  },
  {
    'title': 'link failures/s by reason',
    'host_expr': 'sum by (job, reason) (rate(s3_link_failures_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (reason) (rate(s3_link_failures_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{job}} {{reason}}',
    'cluster_legend': '{{reason}}',
  },
  {
    'title': 'link disconnects/s by cell',
    'host_expr': 'sum by (cell) (rate(s3_link_disconnects_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (cell) (rate(s3_link_disconnects_total[1m]))',
    'unit': 'ops',
    'host_legend': 'cell {{cell}}',
    'cluster_legend': 'cell {{cell}}',
  },
  {
    'title': 'link queue by cell',
    'host_expr': 'sum by (cell) (s3_link_queue_messages{host="HOST"})',
    'cluster_expr': 'sum by (cell) (s3_link_queue_messages)',
    'unit': 'short',
    'host_legend': 'cell {{cell}}',
    'cluster_legend': 'cell {{cell}}',
  },
  {
    'title': 'repair queue (entries this host owes)',
    'host_expr': 's3_repair_queue_entries{host="HOST"}',
    'cluster_expr': 'sum(s3_repair_queue_entries)',
    'unit': 'short',
    'host_legend': 'HOST',
    'cluster_legend': 'sum',
  },
  {
    'title': 'unsettled puts (inprogress marks)',
    'host_expr': 's3_repair_inprogress_entries{host="HOST"}',
    'cluster_expr': 'sum(s3_repair_inprogress_entries)',
    'unit': 'short',
    'host_legend': 'HOST',
    'cluster_legend': 'sum',
  },
  {
    'title': 'repair fixes/s by result',
    'host_expr': 'sum by (result) (rate(s3_repair_fixes_total{host="HOST"}[1m]))',
    'cluster_expr': 'sum by (result) (rate(s3_repair_fixes_total[1m]))',
    'unit': 'ops',
    'host_legend': '{{result}}',
    'cluster_legend': '{{result}}',
  },
  {
    'title': 'repair pass p99',
    'host_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_repair_pass_seconds_bucket{host="HOST"}[1m])))',
    'cluster_expr': 'histogram_quantile(0.99, sum by (le) (rate(s3_repair_pass_seconds_bucket{job="s3_repair"}[1m])))',
    'unit': 's',
    'host_legend': 'HOST',
    'cluster_legend': 'p99',
  },
] %}
{% set hosts = ['lab1', 'lab2', 'lab3'] %}
{
  "uid": "s3",
  "title": "s3",
  "tags": ["s3", "storage"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 0,
  "time": {"from": "now-30m", "to": "now"},
  "timepicker": {},
  "timezone": "",
  "refresh": "15s",
  "annotations": {"list": []},
  "templating": {"list": []},
  "links": [],
  "panels": [
{% for m in metrics %}
{% set is_last_metric = loop.last %}
{% set row = loop.index0 * 6 %}
{% set mi = loop.index0 %}
{% for host in hosts %}
{% set col = loop.index0 * 6 %}
    {
      "id": {{ mi * 4 + loop.index }},
      "title": "{{ m.title }} — {{ host }}",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": {{ col }}, "y": {{ row }}},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "fieldConfig": {"defaults": {"unit": "{{ m.unit }}"}},
      "targets": [
        {"expr": "{{ m.host_expr | replace('HOST', host) | replace('"', '\\"') }}", "legendFormat": "{{ m.host_legend | replace('HOST', host) }}", "refId": "A"}
      ]
    },
{% endfor %}
    {
      "id": {{ mi * 4 + 4 }},
      "title": "{{ m.title }} — cluster",
      "type": "timeseries",
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": {{ row }}},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "fieldConfig": {"defaults": {"unit": "{{ m.unit }}"}},
      "targets": [
        {"expr": "{{ m.cluster_expr | replace('"', '\\"') }}", "legendFormat": "{{ m.cluster_legend }}", "refId": "A"}
      ]
    }{% if not is_last_metric %},{% endif %}
{% endfor %}
  ]
}
