    {
      "id": 9,
      "title": "Front request latency",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "Includes forwarding and backend response time. The host filter applies here; HTTP metrics have no bucket label.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "\u2014",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(kv_http_request_duration_seconds_bucket{job=\"kv_front\",scope=\"external\",host=~\"$host\"}[$__rate_interval])))",
