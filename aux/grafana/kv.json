    {
      "id": 15,
      "title": "Bucket utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "Used key and value bytes divided by the configured capacity of each local bucket.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "\u2014",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          },
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, bucket) (kv_bucket_bytes{job=\"kv_back\",host=~\"$host\",bucket=~\"$bucket\"}) / sum by (host, bucket) (kv_bucket_capacity_bytes{job=\"kv_back\",host=~\"$host\",bucket=~\"$bucket\"})",
          "legendFormat": "{{host}} \u00b7 {{bucket}}",
          "range": true,
          "instant": false,
          "interval": "15s"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 16,
      "title": "Stored bytes by bucket",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 27,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
