      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "title": "HTTP errors",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "GET 404 is excluded from errors; PUT 404 remains a client error. The host filter applies here; HTTP metrics have no bucket label.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "\u2014",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(kv_http_requests_total{job=\"kv_front\",host=~\"$host\",code=~\"5..\"}[$__rate_interval])) or 0 * sum(up{job=\"kv_front\",host=~\"$host\"}))",
          "legendFormat": "front \u00b7 5xx",
          "range": true,
          "instant": false,
          "interval": "15s"
        },
        {
          "refId": "B",
          "expr": "(sum(rate(kv_http_requests_total{job=\"kv_front\",host=~\"$host\",code=~\"4..\"}[$__rate_interval])) or 0 * sum(up{job=\"kv_front\",host=~\"$host\"})) - (sum(rate(kv_http_requests_total{job=\"kv_front\",host=~\"$host\",operation=\"get\",code=\"404\"}[$__rate_interval])) or 0 * sum(up{job=\"kv_front\",host=~\"$host\"}))",
          "legendFormat": "front \u00b7 4xx except GET 404",
          "range": true,
          "instant": false,
          "interval": "15s"
        },
        {
          "refId": "C",
          "expr": "(sum(rate(kv_http_requests_total{job=\"kv_back\",host=~\"$host\",code=~\"5..\"}[$__rate_interval])) or 0 * sum(up{job=\"kv_back\",host=~\"$host\"}))",
          "legendFormat": "back \u00b7 5xx",
          "range": true,
          "instant": false,
          "interval": "15s"
        },
        {
          "refId": "D",
          "expr": "(sum(rate(kv_http_requests_total{job=\"kv_back\",host=~\"$host\",code=~\"4..\"}[$__rate_interval])) or 0 * sum(up{job=\"kv_back\",host=~\"$host\"})) - (sum(rate(kv_http_requests_total{job=\"kv_back\",host=~\"$host\",operation=\"get\",code=\"404\"}[$__rate_interval])) or 0 * sum(up{job=\"kv_back\",host=~\"$host\"}))",
          "legendFormat": "back \u00b7 4xx except GET 404",
          "range": true,
          "instant": false,
          "interval": "15s"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
