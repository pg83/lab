    {
      "id": 8,
      "title": "Front request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "Client requests, counted once at the front. The host filter applies here; HTTP metrics have no bucket label.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "\u2014",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (host, operation) (rate(kv_http_requests_total{job=\"kv_front\",scope=\"external\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{host}} \u00b7 {{operation}}",
          "range": true,
          "instant": false,
          "interval": "15s"
        }
      ],
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
