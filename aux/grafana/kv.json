                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"kv_back\",host=~\"$host\"}) / count(up{job=\"kv_back\",host=~\"$host\"})",
          "legendFormat": "Backend availability",
          "range": false,
          "instant": true,
          "interval": "15s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "title": "Stored data",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "Key and value bytes in the selected buckets and hosts. Storage and Go runtime overhead are excluded.",
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "\u2014"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kv_bucket_bytes{job=\"kv_back\",host=~\"$host\",bucket=~\"$bucket\"})",
          "legendFormat": "Stored data",
          "range": false,
          "instant": true,
          "interval": "15s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
