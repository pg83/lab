    {
      "id": 12,
      "title": "Front HTTP responses",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "GET 404 represents a missing key or bucket. Successful GET is 200 and PUT is 204. The host filter applies here; HTTP metrics have no bucket label.",
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "noValue": "\u2014",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, code) (rate(kv_http_requests_total{job=\"kv_front\",scope=\"external\",host=~\"$host\"}[$__rate_interval]))",
          "legendFormat": "{{operation}} \u00b7 {{code}}",
          "range": true,
          "instant": false,
          "interval": "15s"
        }
