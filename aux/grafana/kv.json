{
  "uid": "kv",
  "title": "KV",
  "description": "Stateless fronts and sharded storage backends. Host selection applies everywhere; bucket selection applies to storage and cache metrics. Stored bytes count keys and values, excluding process memory overhead.",
  "tags": [
    "kv",
    "cache"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "refresh": "15s",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": {
          "query": "label_values(up{job=~\"kv_(front|back)\"}, host)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(up{job=~\"kv_(front|back)\"}, host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": {
          "query": "label_values(kv_bucket_capacity_bytes{job=\"kv_back\",host=~\"$host\"}, bucket)",
          "refId": "VariableQuery"
        },
        "definition": "label_values(kv_bucket_capacity_bytes{job=\"kv_back\",host=~\"$host\"}, bucket)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Front availability",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "description": "Share of selected fronts that Prometheus can scrape. See the availability timeline for individual hosts.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "noValue": "\u2014",
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{job=\"kv_front\",host=~\"$host\"}) / count(up{job=\"kv_front\",host=~\"$host\"})",
          "legendFormat": "Front availability",
          "range": false,
          "instant": true,
          "interval": "15s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "title": "Backend availability",
