{
  "uid": "kv",
  "title": "KV",
  "tags": ["kv"],
  "schemaVersion": 39,
  "version": 2,
  "time": {"from": "now-1h", "to": "now"},
  "refresh": "15s",
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "fieldConfig": {"defaults": {"unit": "ops", "min": 0}},
      "targets": [
        {"expr": "sum by (host, operation) (rate(kv_http_requests_total{job=\"kv_front\",scope=\"external\"}[$__rate_interval]))", "legendFormat": "{{host}} {{operation}}", "refId": "A", "interval": "15s"}
      ]
    },
    {
      "id": 2,
      "title": "Request latency (p95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, host, operation) (rate(kv_http_request_duration_seconds_bucket{job=\"kv_front\",scope=\"external\"}[$__rate_interval])))", "legendFormat": "{{host}} {{operation}}", "refId": "A", "interval": "15s"}
      ]
    },
    {
      "id": 3,
      "title": "Bucket utilization",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"expr": "kv_bucket_bytes{job=\"kv_back\"} / kv_bucket_capacity_bytes{job=\"kv_back\"}", "legendFormat": "{{host}} {{bucket}}", "refId": "A", "interval": "15s"}
      ]
    },
    {
      "id": 4,
      "title": "Cache hit ratio",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prom"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
      "targets": [
        {"expr": "sum by (bucket) (rate(kv_bucket_hits_total{job=\"kv_back\"}[$__rate_interval])) / (sum by (bucket) (rate(kv_bucket_hits_total{job=\"kv_back\"}[$__rate_interval])) + sum by (bucket) (rate(kv_bucket_misses_total{job=\"kv_back\"}[$__rate_interval])))", "legendFormat": "{{bucket}}", "refId": "A", "interval": "15s"}
      ]
    }
  ]
}
