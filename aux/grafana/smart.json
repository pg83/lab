    {
      "id": 5,
      "type": "timeseries",
      "title": "Переназначенные сектора HDD — рост от минимума за 24 ч",
      "description": "Текущее значение минус минимум в доступной части последних 24 часов. Это не число уникальных новых дефектов: pending может уменьшаться. Полная история слева показывает и рост, и снижение. При первом опросе результат 0; это ещё не сутки наблюдений.",
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "smart_ata_attribute_raw_value{host=~\"$host\",serial=~\"$serial\",disk_type=\"hdd\",attribute_id=\"5\"} - min_over_time(smart_ata_attribute_raw_value{host=~\"$host\",serial=~\"$serial\",disk_type=\"hdd\",attribute_id=\"5\"}[24h])",
          "legendFormat": "{{host}} / {{device}} / {{serial}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
