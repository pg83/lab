  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timezone": "",
  "refresh": "1m",
  "annotations": {
    "list": []
  },
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Узел",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": "label_values(smart_device_info, host)",
        "definition": "label_values(smart_device_info, host)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "serial",
        "label": "Серийный номер",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom"
        },
        "query": "label_values(smart_device_info{host=~\"$host\"}, serial)",
        "definition": "label_values(smart_device_info{host=~\"$host\"}, serial)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Как читать SMART",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Опрос примерно раз в 17 минут. Сначала проверьте свежесть и успешность опроса. Постоянные ненулевые значения — накопленная история; рост требует внимания. Pending и Offline Uncorrectable могут описывать одни и те же сектора: их нельзя складывать. Графики секторов ниже относятся к HDD; сырые атрибуты SSD показаны отдельно, их смысл зависит от модели. История Prometheus начинается с подключения этого сбора."
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Возраст последнего опроса",
      "description": "Если возраст больше 40 минут, значения SMART устарели. Отсутствие данных не означает исправность дисков.",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "time() - smart_collect_timestamp_seconds{host=~\"$host\"}",
          "legendFormat": "{{host}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 2400
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Успешность чтения SMART",
      "description": "1 — получены SMART и серийный номер; 0 — ошибка чтения или SMART недоступен. USB-носитель без SMART также даёт 0.",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prom"
      },
      "targets": [
        {
          "expr": "smart_device_scrape_success{host=~\"$host\",serial=~\"$serial\"}",
          "legendFormat": "{{host}} / {{device}} / {{serial}}",
          "refId": "A",
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
