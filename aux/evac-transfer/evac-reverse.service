[Unit]
Description=Reverse SSH from merlin to lab1 for evacuation control
StartLimitIntervalSec=0

[Service]
Type=exec
ExecStart=/usr/bin/ssh -F /dev/null -6 -NT -i %h/qw -p 8101 -o BatchMode=yes -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=%h/.cache/evac-access/lab1_known_hosts -o ConnectTimeout=10 -o ServerAliveInterval=20 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -R 127.0.0.1:18122:[::1]:22 pg@64:ff9b::5bc:67fb
Restart=always
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
